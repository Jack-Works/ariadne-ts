───╯
"
`;

exports[`Report > renders a multiline label and note 1`] = `
"[E01] Error: Invalid expression
   ╭─[example.ts:1:1]
   │
 1 │ ╭─▶ const value = {
 2 │ │     left: 1,
   · │           ┬  
   · │           ╰── This is a number
 3 │ │     right: "1",
   · │            ─┬─  
   · │             ╰─── This is a string
 4 │ ├─▶ }
   · │       
   · ╰─────── Fields use incompatible types
   ·          Compare left and right values
   ·     
   ·     Note: Object fields must agree
───╯
"
`;

