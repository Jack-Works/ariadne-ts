{
    "name": "@magic-works/ariadne",
    "version": "0.3.1",
    "description": "A TypeScript library for generating Rust-style compiler diagnostics",
    "type": "module",
    "packageManager": "pnpm@11.17.0",
    "files": [
        "src",
        "dist"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jack-Works/ariadne-ts.git"
    },
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "typecheck:examples": "tsc -p examples/tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "changeset": "changeset",
        "ci:release": "changeset publish"
    },
    "devDependencies": {
        "@babel/parser": "^8.0.4",
        "@babel/types": "^8.0.4",
        "@changesets/cli": "^2.31.1",
        "@types/estree": "^1.0.9",
        "eslint-visitor-keys": "^5.0.1",
        "espree": "^11.2.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    }
}
